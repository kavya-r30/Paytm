{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/commands/treasury_rails_event.schema.json",
  "title": "TreasuryRailsEvent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "pending",
        "success",
        "failed"
      ]
    },
    "utr": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "amount_paise": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "enum": [
        "upi_qr",
        "upi_static",
        "upi_link"
      ]
    },
    "order_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "payer_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "payer_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "status",
    "utr",
    "amount_paise",
    "mode"
  ]
}
