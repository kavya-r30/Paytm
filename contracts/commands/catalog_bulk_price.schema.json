{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/commands/catalog_bulk_price.schema.json",
  "title": "CatalogBulkPrice",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "prices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "price_paise": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "item_id",
          "price_paise"
        ]
      }
    }
  },
  "required": [
    "prices"
  ]
}
