{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/commands/counter_checkout.schema.json",
  "title": "CounterCheckout",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bill_id": {
      "$ref": "../common.schema.json#/definitions/PrefixedId"
    },
    "payments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": [
              "cash",
              "card"
            ]
          },
          "amount_paise": {
            "type": "integer",
            "minimum": 1
          },
          "tendered_paise": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "mode",
          "amount_paise"
        ]
      },
      "minItems": 1,
      "maxItems": 4
    },
    "coupon_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "bill_id",
    "payments"
  ]
}
