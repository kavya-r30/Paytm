{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/commands/device_report_health.schema.json",
  "title": "DeviceReportHealth",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "device_id": {
      "$ref": "../common.schema.json#/definitions/PrefixedId"
    },
    "connected": {
      "type": "boolean"
    },
    "battery_pct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "mic_muted": {
      "type": "boolean"
    },
    "volume_pct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "queue_size": {
      "type": "integer",
      "minimum": 0
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "device_id",
    "connected",
    "battery_pct",
    "mic_muted",
    "volume_pct",
    "queue_size"
  ]
}
