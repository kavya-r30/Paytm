{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/commands/staff_add_command.schema.json",
  "title": "StaffAddCommand",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "role": {
      "enum": [
        "owner",
        "manager",
        "cashier",
        "helper"
      ]
    }
  },
  "required": [
    "name",
    "role"
  ]
}
