{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/commands/growth_create_plan.schema.json",
  "title": "GrowthCreatePlan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "goal_key": {
      "$ref": "../common.schema.json#/definitions/MessageKey"
    },
    "levers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 1,
      "maxItems": 6
    },
    "budget_paise": {
      "type": "integer",
      "minimum": 0
    },
    "holdout_bp": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 5000
    }
  },
  "required": [
    "goal_key",
    "levers",
    "budget_paise",
    "holdout_bp"
  ]
}
