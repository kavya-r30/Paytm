{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/commands/treasury_record_settlement.schema.json",
  "title": "TreasuryRecordSettlement",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "external_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "gross_paise": {
      "type": "integer",
      "minimum": 0
    },
    "net_paise": {
      "type": "integer"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "fee",
              "edi",
              "refund",
              "other"
            ]
          },
          "amount_paise": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "kind",
          "amount_paise"
        ]
      },
      "minItems": 0,
      "maxItems": 20
    },
    "utrs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 0,
      "maxItems": 5000
    }
  },
  "required": [
    "external_ref",
    "date",
    "gross_paise",
    "net_paise",
    "lines",
    "utrs"
  ]
}
