{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/commands/calendar_add_local_event.schema.json",
  "title": "CalendarAddLocalEvent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "kind": {
      "enum": [
        "fair",
        "market_day",
        "local_festival",
        "closure",
        "other"
      ]
    },
    "start": {
      "type": "string",
      "format": "date"
    },
    "end": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "name",
    "kind",
    "start",
    "end"
  ]
}
