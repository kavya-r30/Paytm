{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/commands/storefront_publish.schema.json",
  "title": "StorefrontPublish",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,40}$"
    },
    "published": {
      "type": "boolean"
    },
    "show_offers": {
      "type": "boolean"
    }
  },
  "required": [
    "slug",
    "published",
    "show_offers"
  ]
}
