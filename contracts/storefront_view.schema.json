{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/storefront_view.schema.json",
  "title": "StorefrontView",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "slug": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "published": {
      "type": "boolean"
    },
    "show_offers": {
      "type": "boolean"
    },
    "items": {
      "type": "integer",
      "minimum": 0
    },
    "url": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "invalidate_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "required": [
    "slug",
    "published",
    "show_offers",
    "items",
    "url",
    "invalidate_on"
  ]
}
