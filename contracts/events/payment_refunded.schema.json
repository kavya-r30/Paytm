{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/events/payment_refunded.schema.json",
  "title": "PaymentRefunded",
  "description": "Event Spine topic payment.refunded (spec Part C5).",
  "type": "object",
  "required": [
    "event_id",
    "type",
    "merchant_id",
    "occurred_at",
    "actor",
    "causation_id",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "const": "payment.refunded"
    },
    "merchant_id": {
      "$ref": "../common.schema.json#/definitions/NonEmptyString"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "$ref": "#/definitions/Actor"
    },
    "causation_id": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/definitions/PrefixedId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Id of the command or event that caused this event; null means a root event with no cause (e.g. a clock tick)."
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refund_id": {
          "$ref": "../common.schema.json#/definitions/PrefixedId"
        },
        "amount_paise": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "refund_id",
        "amount_paise",
        "mode"
      ]
    }
  },
  "definitions": {
    "Actor": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "owner",
            "staff",
            "customer",
            "supplier",
            "agent",
            "system",
            "simulator"
          ]
        },
        "id": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/definitions/NonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
