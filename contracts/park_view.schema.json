{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/park_view.schema.json",
  "title": "ParkView",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "./common.schema.json#/definitions/PrefixedId"
          },
          "patron_id": {
            "anyOf": [
              {
                "$ref": "./common.schema.json#/definitions/PrefixedId"
              },
              {
                "type": "null"
              }
            ]
          },
          "total_paise": {
            "type": "integer",
            "minimum": 0
          },
          "lines": {
            "type": "integer",
            "minimum": 0
          },
          "opened_at": {
            "type": "string",
            "format": "date-time"
          },
          "patron_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "patron_id",
          "total_paise",
          "lines",
          "opened_at",
          "patron_name"
        ]
      }
    },
    "invalidate_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "required": [
    "bills",
    "invalidate_on"
  ]
}
