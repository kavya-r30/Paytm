{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/session_result.schema.json",
  "title": "SessionResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "token": {
      "type": "string"
    },
    "staff_id": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "token",
    "staff_id",
    "expires_at"
  ]
}
