{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/resolution_view.schema.json",
  "title": "ResolutionView",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "stage": {
      "enum": [
        "none",
        "normalize",
        "alias",
        "transliteration",
        "fuzzy",
        "embedding"
      ]
    },
    "candidates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sku": {
            "type": "string"
          },
          "names": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "minProperties": 1
          },
          "unit": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "mrp_paise": {
            "type": "integer"
          },
          "price_paise": {
            "type": "integer"
          },
          "cost_paise": {
            "type": "integer"
          },
          "details": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "salt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "strength": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "form": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "pack_size": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "schedule": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "rx_required": {
                "type": "boolean"
              },
              "duration_minutes": {
                "type": "integer",
                "minimum": 1
              },
              "required_skill": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": []
          },
          "frequency": {
            "type": "integer"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "sku",
          "names",
          "unit",
          "price_paise",
          "frequency"
        ]
      }
    },
    "selected": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "sku": {
              "type": "string"
            },
            "names": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              },
              "minProperties": 1
            },
            "unit": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "mrp_paise": {
              "type": "integer"
            },
            "price_paise": {
              "type": "integer"
            },
            "cost_paise": {
              "type": "integer"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "salt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "strength": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "form": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "pack_size": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "schedule": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "rx_required": {
                  "type": "boolean"
                },
                "duration_minutes": {
                  "type": "integer",
                  "minimum": 1
                },
                "required_skill": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": []
            },
            "frequency": {
              "type": "integer"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "id",
            "sku",
            "names",
            "unit",
            "price_paise",
            "frequency"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "needs_clarification": {
      "type": "boolean"
    },
    "invalidate_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "stage",
    "candidates",
    "selected",
    "needs_clarification",
    "invalidate_on"
  ]
}
