{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/khata_account_view.schema.json",
  "title": "KhataAccountView",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "$ref": "./common.schema.json#/definitions/PrefixedId"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "./common.schema.json#/definitions/PrefixedId"
          },
          "account_id": {
            "$ref": "./common.schema.json#/definitions/PrefixedId"
          },
          "amount_paise": {
            "type": "integer"
          },
          "source": {
            "type": "string"
          },
          "ref_id": {
            "anyOf": [
              {
                "$ref": "./common.schema.json#/definitions/PrefixedId"
              },
              {
                "type": "null"
              }
            ]
          },
          "member_id": {
            "anyOf": [
              {
                "$ref": "./common.schema.json#/definitions/PrefixedId"
              },
              {
                "type": "null"
              }
            ]
          },
          "reversal_of": {
            "anyOf": [
              {
                "$ref": "./common.schema.json#/definitions/PrefixedId"
              },
              {
                "type": "null"
              }
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "open",
              "disputed",
              "acknowledged",
              "resolved"
            ]
          },
          "allocated_paise": {
            "type": "integer",
            "minimum": 0
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "item_id": {
                  "anyOf": [
                    {
                      "$ref": "./common.schema.json#/definitions/PrefixedId"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "description_key": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "qty_milli": {
                  "type": "integer"
                },
                "unit_price_paise": {
                  "type": "integer",
                  "minimum": 0
                },
                "amount_paise": {
                  "type": "integer"
                }
              },
              "required": [
                "item_id",
                "description_key",
                "qty_milli",
                "unit_price_paise",
                "amount_paise"
              ]
            }
          }
        },
        "required": [
          "id",
          "account_id",
          "amount_paise",
          "source",
          "ref_id",
          "member_id",
          "reversal_of",
          "occurred_at",
          "status",
          "allocated_paise",
          "lines"
        ]
      }
    },
    "payments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "payment_ref": {
            "$ref": "./common.schema.json#/definitions/PrefixedId"
          },
          "amount_paise": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "type": "string"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "payment_ref",
          "amount_paise",
          "mode",
          "occurred_at"
        ]
      }
    },
    "entries_paise": {
      "type": "integer"
    },
    "allocated_paise": {
      "type": "integer",
      "minimum": 0
    },
    "balance_paise": {
      "type": "integer",
      "minimum": 0
    },
    "advance_paise": {
      "type": "integer",
      "minimum": 0
    },
    "invalidate_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "patron_id": {
      "$ref": "./common.schema.json#/definitions/PrefixedId"
    },
    "display_name": {
      "type": "string"
    },
    "limit_paise": {
      "type": "integer",
      "minimum": 0
    },
    "promises": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "./common.schema.json#/definitions/PrefixedId"
          },
          "amount_paise": {
            "type": "integer",
            "minimum": 0
          },
          "due_on": {
            "type": "string",
            "format": "date"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "kept",
              "broken"
            ]
          }
        },
        "required": [
          "id",
          "amount_paise",
          "due_on",
          "occurred_at",
          "status"
        ]
      }
    },
    "pay_link_ref": {
      "anyOf": [
        {
          "$ref": "./common.schema.json#/definitions/PrefixedId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "account_id",
    "as_of",
    "entries",
    "payments",
    "entries_paise",
    "allocated_paise",
    "balance_paise",
    "advance_paise",
    "invalidate_on",
    "patron_id",
    "display_name",
    "limit_paise",
    "promises",
    "pay_link_ref"
  ]
}
