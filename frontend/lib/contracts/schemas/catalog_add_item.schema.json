{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/commands/catalog_add_item.schema.json",
  "title": "CatalogAddItem",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sku": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "names": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "minProperties": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "mrp_paise": {
      "type": "integer",
      "minimum": 0
    },
    "price_paise": {
      "type": "integer",
      "minimum": 0
    },
    "cost_paise": {
      "type": "integer",
      "minimum": 0
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "uniqueItems": true
    },
    "barcodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{8,14}$"
      },
      "uniqueItems": true
    },
    "hsn": {
      "type": "string",
      "pattern": "^[0-9]{4,8}$"
    },
    "gst_rate_bp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "salt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "strength": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "form": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "pack_size": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "schedule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "rx_required": {
          "type": "boolean"
        },
        "duration_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "required_skill": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": []
    },
    "modifier_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "delta_paise": {
                  "type": "integer"
                }
              },
              "required": [
                "name",
                "delta_paise"
              ]
            }
          }
        },
        "required": [
          "name",
          "required",
          "options"
        ]
      }
    },
    "recipe": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "qty_milli": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "item_id",
          "qty_milli"
        ]
      }
    }
  },
  "required": [
    "sku",
    "names",
    "unit",
    "price_paise",
    "cost_paise",
    "mrp_paise",
    "category"
  ]
}
