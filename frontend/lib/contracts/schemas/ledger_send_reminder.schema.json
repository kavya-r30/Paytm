{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/commands/ledger_send_reminder.schema.json",
  "title": "LedgerSendReminder",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "$ref": "../common.schema.json#/definitions/PrefixedId"
    },
    "template_key": {
      "$ref": "../common.schema.json#/definitions/MessageKey"
    },
    "manual": {
      "type": "boolean",
      "description": "The owner sends this reminder now, by hand: quiet hours, weekly cap, minimum age and spacing do not apply (consent, a due balance and no dispute still do; agents cannot set it)."
    }
  },
  "required": [
    "account_id",
    "template_key"
  ]
}
