{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/ask_view.schema.json",
  "title": "AskView",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "./common.schema.json#/definitions/PrefixedId"
          },
          "surface": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "heard": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "said": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "surface",
          "heard",
          "intent",
          "said",
          "created_at"
        ]
      }
    },
    "invalidate_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "required": [
    "session",
    "turns",
    "invalidate_on"
  ]
}
