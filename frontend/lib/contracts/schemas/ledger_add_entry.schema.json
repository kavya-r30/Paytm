{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/commands/ledger_add_entry.schema.json",
  "title": "LedgerAddEntry",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "$ref": "../common.schema.json#/definitions/PrefixedId"
    },
    "amount_paise": {
      "type": "integer",
      "minimum": 1
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "anyOf": [
              {
                "$ref": "../common.schema.json#/definitions/PrefixedId"
              },
              {
                "type": "null"
              }
            ]
          },
          "qty_milli": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price_paise": {
            "type": "integer",
            "minimum": 0
          },
          "description_key": {
            "$ref": "../common.schema.json#/definitions/MessageKey"
          }
        },
        "required": [
          "item_id",
          "qty_milli",
          "unit_price_paise"
        ]
      }
    },
    "source": {
      "enum": [
        "counter",
        "voice",
        "order",
        "import"
      ]
    },
    "ref_id": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/definitions/PrefixedId"
        },
        {
          "type": "null"
        }
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "member_id": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/definitions/PrefixedId"
        },
        {
          "type": "null"
        }
      ]
    },
    "limit_override": {
      "type": "boolean"
    },
    "reason_key": {
      "$ref": "../common.schema.json#/definitions/MessageKey"
    }
  },
  "required": [
    "account_id",
    "amount_paise",
    "lines",
    "source"
  ]
}
