{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/latest_ref_view.schema.json",
  "title": "LatestRefView",
  "description": "The newest record of a kind in the session's shop, so a detail screen opened without an id shows real data (null: the shop has none yet, the screen shows its empty state).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["bill_open", "bill_closed", "gate", "po", "claim", "offer", "plan", "campaign", "run", "order", "verdict", "item", "patron"]
    },
    "id": {
      "anyOf": [{ "$ref": "./common.schema.json#/definitions/PrefixedId" }, { "type": "null" }]
    },
    "invalidate_on": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["kind", "id", "invalidate_on"]
}
