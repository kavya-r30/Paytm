{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/bundles_view.schema.json",
  "title": "BundlesView",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "./common.schema.json#/definitions/PrefixedId"
            }
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "price_paise": {
            "type": "integer",
            "minimum": 0
          },
          "margin_bp": {
            "type": "integer"
          },
          "support": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "names",
          "price_paise",
          "margin_bp",
          "support"
        ]
      }
    },
    "preorders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "./common.schema.json#/definitions/PrefixedId"
          },
          "patron_id": {
            "$ref": "./common.schema.json#/definitions/PrefixedId"
          },
          "total_paise": {
            "type": "integer",
            "minimum": 0
          },
          "deposit_paise": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "patron_id",
          "total_paise",
          "deposit_paise",
          "status"
        ]
      }
    },
    "invalidate_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "required": [
    "bundles",
    "preorders",
    "invalidate_on"
  ]
}
