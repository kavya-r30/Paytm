{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/customer_search_view.schema.json",
  "title": "CustomerSearchView",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "customers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "patron_id": {
            "$ref": "./common.schema.json#/definitions/PrefixedId"
          },
          "display_name": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "patron_id",
          "display_name",
          "confidence"
        ]
      }
    },
    "needs_clarification": {
      "type": "boolean"
    },
    "invalidate_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recent": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "patron_id",
          "display_name",
          "phone_masked",
          "khata_balance_paise",
          "reward_stamps"
        ],
        "properties": {
          "patron_id": {
            "$ref": "./common.schema.json#/definitions/PrefixedId"
          },
          "display_name": {
            "type": "string"
          },
          "phone_masked": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "khata_balance_paise": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "reward_stamps": {
            "type": "integer"
          }
        }
      }
    }
  },
  "required": [
    "customers",
    "needs_clarification",
    "invalidate_on",
    "recent"
  ]
}
