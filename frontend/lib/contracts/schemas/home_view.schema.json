{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/home_view.schema.json",
  "title": "HomeView",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "greeting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "shop_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "now": {
          "type": "string",
          "format": "date-time"
        },
        "part_of_day": {
          "enum": [
            "morning",
            "midday",
            "evening",
            "night"
          ]
        }
      },
      "required": [
        "owner_name",
        "shop_name",
        "now",
        "part_of_day"
      ]
    },
    "today": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sales_paise": {
          "type": "integer",
          "minimum": 0
        },
        "bills": {
          "type": "integer",
          "minimum": 0
        },
        "customers": {
          "type": "integer",
          "minimum": 0
        },
        "new_customers": {
          "type": "integer",
          "minimum": 0
        },
        "by_mode": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      },
      "required": [
        "sales_paise",
        "bills",
        "customers",
        "new_customers",
        "by_mode"
      ]
    },
    "khata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outstanding_paise": {
          "type": "integer"
        },
        "change_today_paise": {
          "type": "integer"
        }
      },
      "required": [
        "outstanding_paise",
        "change_today_paise"
      ]
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gate_id": {
            "$ref": "./common.schema.json#/definitions/PrefixedId"
          },
          "thread_id": {
            "$ref": "./common.schema.json#/definitions/PrefixedId"
          },
          "tier": {
            "$ref": "./common.schema.json#/definitions/Tier"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "title_key": {
            "$ref": "./common.schema.json#/definitions/MessageKey"
          },
          "summary_params": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "required": [
          "gate_id",
          "thread_id",
          "tier",
          "type",
          "status",
          "expires_at",
          "title_key",
          "summary_params"
        ]
      }
    },
    "brief": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "data_sufficiency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "cold_start",
            "learning",
            "ready"
          ]
        },
        "days_of_history": {
          "type": "integer",
          "minimum": 0
        },
        "reason_key": {
          "$ref": "./common.schema.json#/definitions/MessageKey"
        }
      },
      "required": [
        "status",
        "days_of_history",
        "reason_key"
      ]
    },
    "invalidate_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "required": [
    "greeting",
    "today",
    "khata",
    "gates",
    "brief",
    "data_sufficiency",
    "invalidate_on"
  ]
}
