{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/turn_request.schema.json",
  "title": "TurnRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "audio_b64": {
      "type": "string",
      "maxLength": 4000000
    },
    "surface": {
      "enum": [
        "device",
        "console",
        "whatsapp",
        "voice"
      ]
    },
    "bill_id": {
      "$ref": "./common.schema.json#/definitions/PrefixedId"
    },
    "lang": {
      "$ref": "./common.schema.json#/definitions/Locale"
    }
  },
  "required": [
    "surface"
  ]
}
