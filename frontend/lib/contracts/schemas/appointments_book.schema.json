    "service_item_id": {
      "$ref": "../common.schema.json#/definitions/PrefixedId"
    },
    "staff_id": {
      "$ref": "../common.schema.json#/definitions/PrefixedId"
    },
    "start_at": {
      "type": "string",
      "format": "date-time"
    },
    "patron_id": {
      "$ref": "../common.schema.json#/definitions/PrefixedId"
    },
    "source": {
