{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/commands/supply_draft_po.schema.json",
  "title": "SupplyDraftPo",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "supplier_id": {
      "$ref": "../common.schema.json#/definitions/PrefixedId"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "$ref": "../common.schema.json#/definitions/PrefixedId"
          },
          "qty_milli": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price_paise": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "item_id",
          "qty_milli",
          "unit_price_paise"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "due_on": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "supplier_id",
    "lines"
  ]
}
