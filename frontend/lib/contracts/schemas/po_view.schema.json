{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/po_view.schema.json",
  "title": "PoView",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "po": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "./common.schema.json#/definitions/PrefixedId"
        },
        "supplier_id": {
          "$ref": "./common.schema.json#/definitions/PrefixedId"
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "total_paise": {
          "type": "integer",
          "minimum": 0
        },
        "due_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "item_id": {
                "$ref": "./common.schema.json#/definitions/PrefixedId"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "qty_milli": {
                "type": "integer",
                "minimum": 1
              },
              "unit_price_paise": {
                "type": "integer",
                "minimum": 0
              },
              "amount_paise": {
                "type": "integer",
                "minimum": 0
              },
              "last_price_paise": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "item_id",
              "name",
              "qty_milli",
              "unit_price_paise",
              "amount_paise",
              "last_price_paise"
            ]
          }
        }
      },
      "required": [
        "id",
        "supplier_id",
        "status",
        "total_paise",
        "due_on",
        "created_at",
        "lines"
      ]
    },
    "price_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "$ref": "./common.schema.json#/definitions/PrefixedId"
          },
          "unit_price_paise": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "item_id",
          "unit_price_paise",
          "source",
          "occurred_at"
        ]
      }
    },
    "invalidate_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "required": [
    "po",
    "price_history",
    "invalidate_on"
  ]
}
