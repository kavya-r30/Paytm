{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/commands/staff_login.schema.json",
  "title": "StaffLogin",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "device_credential": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "staff_id": {
      "type": "string",
      "minLength": 1
    },
    "pin": {
      "type": "string",
      "pattern": "^[0-9]{4,8}$"
    },
    "channel": {
      "enum": [
        "device",
        "console"
      ]
    }
  },
  "required": [
    "device_credential",
    "staff_id",
    "pin",
    "channel"
  ]
}
