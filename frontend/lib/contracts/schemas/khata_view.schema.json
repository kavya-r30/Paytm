{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/khata_view.schema.json",
  "title": "KhataView",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "accounts": {
      "type": "array",
      "items": {
        "$ref": "./khata_account_view.schema.json"
      }
    },
    "balance_paise": {
      "type": "integer",
      "minimum": 0
    },
    "advance_paise": {
      "type": "integer",
      "minimum": 0
    },
    "invalidate_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "accounts",
    "balance_paise",
    "advance_paise",
    "invalidate_on"
  ]
}
