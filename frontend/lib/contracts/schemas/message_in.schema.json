{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.local/contracts/events/message_in.schema.json",
  "title": "MessageIn",
  "description": "Event Spine topic message.in (spec Part C5).",
  "type": "object",
  "required": [
    "event_id",
    "type",
    "merchant_id",
    "occurred_at",
    "actor",
    "causation_id",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "const": "message.in"
    },
    "merchant_id": {
      "$ref": "../common.schema.json#/definitions/NonEmptyString"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "$ref": "#/definitions/Actor"
    },
    "causation_id": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/definitions/PrefixedId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Id of the command or event that caused this event; null means a root event with no cause (e.g. a clock tick)."
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "$ref": "../common.schema.json#/definitions/PrefixedId"
        },
        "persona_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "patron_id": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/definitions/PrefixedId"
            },
            {
              "type": "null"
            }
          ]
        },
        "supplier_id": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/definitions/PrefixedId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "message_id",
        "persona_ref",
        "patron_id",
        "supplier_id"
      ]
    }
  },
  "definitions": {
    "Actor": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "owner",
            "staff",
            "customer",
            "supplier",
            "agent",
            "system",
            "simulator"
          ]
        },
        "id": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/definitions/NonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
