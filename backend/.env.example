# Arth environment template. Copy to `backend/.env` (this folder) and fill in.
# `.env` holds secrets: never paste it into chats, slides or shared folders.
# Only the API process reads this file. The web app never sees these keys
# (it only gets NEXT_PUBLIC_* values from frontend/.env.local).

# ---- App -------------------------------------------------------------------
# dev | test | demo | prod. prod refuses to start without every provider key;
# dev and demo fall back to recorded cassettes when a key is missing.
ARTH_MODE=dev
# Where arth.db and snapshots live (default: backend/data)
# ARTH_DATA_DIR=./data
# Bearer tokens for each surface (change these before any shared demo)
ARTH_DIRECTOR_TOKEN=dev-director
ARTH_DEVICE_TOKEN=dev-device
ARTH_CONSOLE_TOKEN=dev-console
ARTH_CORS_ORIGINS=["http://localhost:3000"]

# ---- AI providers (spec Part G) --------------------------------------------
# Mistral: main LLM (routing, tools, narration, Critic), vision, OCR.
# Key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Groq: LLM backup, Whisper STT backup, persona simulator for Arena.
# Key: https://console.groq.com/keys
GROQ_API_KEY=

# Sarvam: speech to text (Saaras v4), text to speech (Bulbul v4 Flash),
# translation and transliteration, Indic document OCR backup (Sarvam Vision).
# Key: https://dashboard.sarvam.ai
SARVAM_API_KEY=

# ---- Optional: trace archive -----------------------------------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
